# Copy to .env and fill in. Never commit .env.

# PostgreSQL (Docker Compose)
POSTGRES_USER=netsentinel
POSTGRES_PASSWORD=change-me
POSTGRES_DB=netsentinel
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# psycopg 3 driver; use postgresql+psycopg2:// if you stay on psycopg2
DATABASE_URL=postgresql+psycopg://netsentinel:change-me@localhost:5432/netsentinel

# RIPEstat: identifies the app on every call
RIPESTAT_SOURCEAPP=netsentinel

# LLMs (from Phase 0, Week 3)
ANTHROPIC_API_KEY=
OLLAMA_HOST=http://localhost:11434
